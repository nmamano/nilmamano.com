# /etc/nilmamano/auto-deploy.env (0600, root; the directory is 0700). Plain KEY=value
# lines, read by auto-deploy.sh and never run as shell. No secrets here: the site's API keys
# go in /etc/nilmamano/site.env (compose.yaml), and the Cloudflare purge token in
# /etc/nilmamano/purge-token (0600, one line).
NM_IMAGE=ghcr.io/nmamano/nilmamano-site
NM_GITHUB_REPO=nmamano/nilmamano.com
NM_IMAGE_WORKFLOW=site-image.yml
# The Cloudflare zone of nilmamano.com (an ID, not a secret). Without it, no purge runs.
#NM_CF_ZONE=<zone id>
# Optional: the tag to follow (default main).
#NM_TAG=main
